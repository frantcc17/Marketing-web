{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.js": { "maxDuration": 120 }
  },
  "rewrites": [{ "source": "/((?!api).*)", "destination": "/index.html" }]
}
