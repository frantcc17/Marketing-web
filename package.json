{
  "name": "convence-al-algoritmo",
  "version": "1.0.0",
  "private": true,
  "description": "Juego multijugador de clase sobre retail media y comercio agéntico",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --ignore client server/index.ts",
    "build": "vite build && node scripts/build-api.mjs",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx server/simulate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@upstash/redis": "^1.41.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "qrcode": "^1.5.4",
    "redis": "^6.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
