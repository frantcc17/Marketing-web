# Clave de la API de Anthropic. Sin ella, ARIA usa el motor de respaldo (sin IA).
ANTHROPIC_API_KEY=
# Modelo que usa ARIA
ARIA_MODEL=claude-sonnet-5-5
# Puerto del servidor
PORT=3000
# Opcional: URL pública para el QR (p. ej. https://mi-juego.onrender.com). Si no se pone, se usa la IP local.
PUBLIC_URL=
